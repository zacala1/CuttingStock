<Window x:Class="CuttingStock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CuttingStock"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:twod="clr-namespace:CuttingStock.UI.TwoD"
        xmlns:svc="clr-namespace:CuttingStock.UI.Services"
        mc:Ignorable="d"
        Title="Cutting Stock 최적화 (1D + 2D)" Height="820" Width="1400"
        MinHeight="600" MinWidth="900"
        AllowDrop="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Drop="MainWindow_Drop"
        DragOver="MainWindow_DragOver"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <svc:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </Window.Resources>
    <DockPanel>
    <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0">
        <StatusBarItem><TextBlock Text="{Binding StatusText, FallbackValue=준비됨}" Margin="6,0"/></StatusBarItem>
        <Separator/>
        <StatusBarItem><TextBlock Text="{Binding StatusTip, FallbackValue=Ctrl+R 실행 · Ctrl+Shift+C 비교 · F1 예제 · Esc 취소}" Foreground="Gray" Margin="6,0"/></StatusBarItem>
    </StatusBar>
    <TabControl x:Name="topTabControl" SelectedIndex="0" SelectionChanged="TopTabControl_SelectionChanged">
    <TabItem Header="1D 절단 (Rebar)">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" MinWidth="250"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 패널: 입력 -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 재고 입력 -->
            <GroupBox Grid.Row="0" Margin="0,0,0,5">
                <GroupBox.Header>
                    <TextBlock><Run Text="재고 "/><Run Text="{Binding Stocks.Count, StringFormat='({0}건)', Mode=OneWay}" Foreground="Gray"/></TextBlock>
                </GroupBox.Header>
                <StackPanel>
                    <DataGrid x:Name="stockGrid" AutoGenerateColumns="False" Height="200" Margin="0,0,0,10"
                              ItemsSource="{Binding Stocks}"
                              KeyDown="DataGrid_KeyDown" CellEditEnding="DataGrid_CellEditEnding" CanUserDeleteRows="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="길이 (mm)" Binding="{Binding Length}" Width="*"/>
                            <DataGridTextColumn Header="수량 (개)" Binding="{Binding Quantity}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="재고 추가" Command="{Binding AddStockCommand}" Margin="0,0,5,0" Width="80"/>
                        <Button Content="선택 삭제" Click="DeleteSelectedStock_Click" Margin="0,0,5,0" Width="80"/>
                        <Button Content="파일 불러오기" Click="ImportStock_Click" Width="100"/>
                    </StackPanel>
                    <TextBlock Text="※ 엑셀 붙여넣기(Ctrl+V) 지원 / Delete키로 행 삭제" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 주문 입력 -->
            <GroupBox Grid.Row="1" Margin="0,5,0,0">
                <GroupBox.Header>
                    <TextBlock><Run Text="주문 "/><Run Text="{Binding Orders.Count, StringFormat='({0}건)', Mode=OneWay}" Foreground="Gray"/></TextBlock>
                </GroupBox.Header>
                <StackPanel>
                    <DataGrid x:Name="orderGrid" AutoGenerateColumns="False" Height="200" Margin="0,0,0,10"
                              ItemsSource="{Binding Orders}"
                              KeyDown="DataGrid_KeyDown" CellEditEnding="DataGrid_CellEditEnding" CanUserDeleteRows="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="길이 (mm)" Binding="{Binding Length}" Width="*"/>
                            <DataGridTextColumn Header="수량 (개)" Binding="{Binding Quantity}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="주문 추가" Command="{Binding AddOrderCommand}" Width="80" Margin="0,0,5,0"/>
                        <Button Content="선택 삭제" Click="DeleteSelectedOrder_Click" Margin="0,0,5,0" Width="80"/>
                        <Button Content="파일 불러오기" Click="ImportOrder_Click" Width="100"/>
                    </StackPanel>
                    <TextBlock Text="※ 엑셀 붙여넣기(Ctrl+V) 지원 / Delete키로 행 삭제" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 공통 버튼: 예제 로드 / 시나리오 / 초기화 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                <Button Content="예제 로드" Command="{Binding LoadExampleCommand}" Width="80" Margin="0,0,5,0"/>
                <Button Content="시나리오 저장" Command="{Binding SaveScenarioCommand}" Width="100" Margin="0,0,5,0"
                        ToolTip="현재 재고/주문/파라미터를 .json 파일로 저장"/>
                <Button Content="시나리오 열기" Command="{Binding LoadScenarioCommand}" Width="100" Margin="0,0,5,0"
                        ToolTip="저장된 .json 시나리오를 불러오기"/>
                <Button x:Name="btnRecent1D" Content="최근 ▾" Click="Recent1D_Click" Width="65" Margin="0,0,5,0"
                        ToolTip="최근에 사용한 시나리오 (최대 5개)"/>
                <Button Content="전체 초기화" Command="{Binding ClearAllCommand}" Width="80"/>
            </StackPanel>
        </Grid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="LightGray" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

        <!-- 오른쪽 패널: 설정 및 결과 -->
        <Grid Grid.Column="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 알고리즘 설정 -->
            <GroupBox Header="알고리즘 설정" Grid.Row="0" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 알고리즘 선택 -->
                    <TextBlock Text="알고리즘 선택:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="algorithmComboBox" Grid.Row="0" Grid.Column="1" Margin="5"
                              SelectedIndex="{Binding AlgorithmIndex}"
                              SelectionChanged="AlgorithmComboBox_SelectionChanged">
                        <ComboBoxItem Content="Greedy Knapsack DP (근최적, 빠름)"/>
                        <ComboBoxItem Content="Column Generation LP (전역 최적화)"/>
                        <ComboBoxItem Content="Arc Flow MIP (정확 최적, OR-Tools)"/>
                    </ComboBox>

                    <!-- 파라미터 설정 -->
                    <TextBlock Text="파라미터 설정:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="5,10,5,5"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,10,5,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Alpha -->
                            <TextBlock Text="Alpha (자투리 비용):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"
                                       ToolTip="자투리(폐기) 1mm당 비용 (원/mm). 총비용 = 폐기길이 × Alpha + 용접횟수 × Beta"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="5"
                                     Text="{Binding AlphaText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                     ToolTip="원/mm — 자투리 단가"/>

                            <!-- Beta -->
                            <TextBlock Text="Beta (용접 비용):" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="10,5,0,5"
                                       ToolTip="용접 1회당 비용 (원/회). 긴 주문을 여러 조각으로 나눠 잇는 비용"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Margin="5"
                                     Text="{Binding BetaText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                     ToolTip="원/회 — 용접 단가"/>

                            <!-- Gamma -->
                            <TextBlock Text="Gamma (재사용 최소):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"
                                       ToolTip="이 길이(mm) 이상의 자투리는 '재사용 가능'으로 분류, 미만은 '폐기'로 카운트"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="5"
                                     Text="{Binding GammaText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                     ToolTip="mm — 재사용 가능 자투리 최소 길이"/>

                            <!-- Delta -->
                            <TextBlock Text="Delta (용접 최소):" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="10,5,0,5"
                                       ToolTip="용접 시 각 조각의 최소 길이(mm). 이보다 짧은 조각은 용접 불가"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Margin="5"
                                     Text="{Binding DeltaText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                     ToolTip="mm — 용접 가능 조각 최소 길이"/>

                            <!-- Kerf -->
                            <TextBlock Text="Kerf (톱날 두께):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"
                                       ToolTip="톱날 두께(mm). 인접한 두 절단 사이에 이만큼 재료가 소비됨. 0 = 무시"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="5"
                                     Text="{Binding KerfText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                     ToolTip="mm — 톱날 두께. 0 = 무시"/>

                            <!-- UsageOrder -->
                            <TextBlock Text="재고 사용 순서:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"
                                       ToolTip="여러 길이의 재고가 있을 때 어떤 것부터 사용할지"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="5"
                                      SelectedIndex="{Binding UsageOrderIndex}">
                                <ComboBoxItem Content="작은 것부터 (Small to Large)"/>
                                <ComboBoxItem Content="큰 것부터 (Large to Small)"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <!-- 알고리즘별 고급 옵션 -->
                    <TextBlock Text="고급 옵션:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="5,10,5,5"/>
                    <Border Grid.Row="2" Grid.Column="1" Margin="5,10,5,5" BorderBrush="LightGray" BorderThickness="1" Padding="5">
                        <StackPanel x:Name="advancedOptionsPanel">
                            <TextBlock Text="(알고리즘을 선택하면 고급 옵션이 표시됩니다)" Foreground="Gray" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <!-- 용접 옵션 -->
                    <TextBlock Text="용접 옵션:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                    <CheckBox Grid.Row="3" Grid.Column="1"
                              Content="용접 활성화 (긴 주문을 여러 조각으로 분할)"
                              IsChecked="{Binding EnableWelding}"
                              Margin="5" VerticalAlignment="Center"
                              ToolTip="체크하면 재고 길이를 초과하는 주문을 Delta 이상의 조각들로 분할해 용접"/>

                    <!-- 실행 버튼 -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,5">
                        <Button Content="최적화 실행" Command="{Binding CalculateCommand}" Width="120" Height="35" Margin="0,0,10,0" FontWeight="Bold"
                                ToolTip="Ctrl+R 단축키"/>
                        <Button Content="알고리즘 비교" Command="{Binding CompareAlgorithmsCommand}" Width="120" Height="35" FontWeight="Bold"
                                ToolTip="Ctrl+Shift+C 단축키"/>
                    </StackPanel>

                    <!-- 진행 상태 표시 (오버레이) -->
                    <Grid Grid.Row="0" Grid.RowSpan="5" Grid.ColumnSpan="2" Background="#80FFFFFF"
                          Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar Width="200" Height="20"
                                         IsIndeterminate="{Binding ProgressIndeterminate}"
                                         Value="{Binding ProgressPercent}"
                                         Minimum="0" Maximum="100"/>
                            <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="Bold"/>
                            <Button Content="취소" Command="{Binding CancelCommand}" Width="80" Margin="0,8,0,0" HorizontalAlignment="Center"
                                    ToolTip="Esc 키로도 취소"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- 결과 표시 -->
            <TabControl Grid.Row="1" x:Name="mainTabControl">
                <!-- 단일 결과 탭 -->
                <TabItem Header="최적화 결과">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 검색 바 (Ctrl+F로 토글) -->
                        <Border x:Name="searchBar" Grid.Row="0" Background="#F8F8F8" BorderBrush="LightGray" BorderThickness="0,0,0,1"
                                Padding="6" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="검색:" VerticalAlignment="Center" Margin="2,0,6,0"/>
                                <TextBox x:Name="searchBox" Width="220" KeyDown="SearchBox_KeyDown" VerticalAlignment="Center"/>
                                <Button Content="다음 (F3)" Click="SearchNext_Click" Margin="6,0,0,0" Padding="6,2"/>
                                <Button Content="이전 (Shift+F3)" Click="SearchPrev_Click" Margin="4,0,0,0" Padding="6,2"/>
                                <Button Content="닫기 (Esc)" Click="SearchClose_Click" Margin="4,0,0,0" Padding="6,2"/>
                                <TextBlock x:Name="searchStatus" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                            </StackPanel>
                        </Border>

                        <TextBox x:Name="resultTextBox" Grid.Row="1" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Padding="10"
                                 Text="{Binding ResultText, Mode=OneWay}"/>

                        <!-- 내보내기 버튼 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                            <Button Content="CSV로 내보내기"   Command="{Binding ExportToCsvCommand}"   Width="120" Margin="0,0,5,0" IsEnabled="{Binding HasSingleResult}"/>
                            <Button Content="Excel로 내보내기" Command="{Binding ExportToExcelCommand}" Width="120" IsEnabled="{Binding HasSingleResult}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- 시각화 탭 -->
                <TabItem Header="결과 시각화">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasSingleResult, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="📊" HorizontalAlignment="Center" FontSize="48" Foreground="LightGray"/>
                            <TextBlock Text="최적화 결과가 여기에 시각화됩니다" HorizontalAlignment="Center"
                                       FontSize="14" Foreground="Gray" Margin="0,8,0,4"/>
                            <TextBlock Text="좌측에 재고와 주문을 입력하고 '최적화 실행' (Ctrl+R)을 누르세요"
                                       HorizontalAlignment="Center" FontSize="11" Foreground="DarkGray"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSingleResult, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- 범례 (Legend) -->
                                <Border BorderBrush="LightGray" BorderThickness="1" Margin="10" Padding="5" Background="White">
                                    <StackPanel>
                                        <TextBlock Text="범례 (Legend)" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <ItemsControl ItemsSource="{Binding LegendItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                                                        <Rectangle Width="15" Height="15" Fill="{Binding Color}" Stroke="Gray" StrokeThickness="1" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- 시각화 메인 아이템 -->
                                <ItemsControl ItemsSource="{Binding VisualizationRows}" Margin="10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#CCC" BorderThickness="1" Margin="0,0,0,8" Padding="8" CornerRadius="3" Background="White">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Text="{Binding InfoText}" Margin="0,0,0,4" FontWeight="SemiBold"/>

                                                    <Border Grid.Row="1" BorderBrush="#999" BorderThickness="1" Height="38" Background="#F5F5F5">
                                                        <ItemsControl ItemsSource="{Binding Blocks}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="{Binding Width}" Height="36"
                                                                            Background="{Binding Color}"
                                                                            BorderBrush="{Binding BorderColor}" BorderThickness="0,0,1,0"
                                                                            ToolTip="{Binding ToolTip}">
                                                                        <TextBlock Text="{Binding Text}"
                                                                                 Foreground="{Binding TextColor}"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 FontSize="10"
                                                                                 TextTrimming="None"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- 비교 결과 탭 -->
                <TabItem Header="알고리즘 비교">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasComparisonResults, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="📈" HorizontalAlignment="Center" FontSize="48" Foreground="LightGray"/>
                            <TextBlock Text="세 알고리즘의 결과를 한눈에 비교합니다" HorizontalAlignment="Center"
                                       FontSize="14" Foreground="Gray" Margin="0,8,0,4"/>
                            <TextBlock Text="'알고리즘 비교' (Ctrl+Shift+C) 버튼을 누르면 표 · 차트 · 상세 리포트가 표시됩니다"
                                       HorizontalAlignment="Center" FontSize="11" Foreground="DarkGray"/>
                        </StackPanel>

                        <Grid Visibility="{Binding HasComparisonResults, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="300"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 비교 요약 테이블 -->
                            <DataGrid Grid.Row="0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Height="150"
                                      Margin="10"
                                      ItemsSource="{Binding ComparisonResults}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="알고리즘" Binding="{Binding AlgorithmName}" Width="200"/>
                                    <DataGridTextColumn Header="총 비용" Binding="{Binding TotalCost, StringFormat=N0}" Width="100"/>
                                    <DataGridTextColumn Header="낭비(mm)" Binding="{Binding WasteLength, StringFormat=N0}" Width="100"/>
                                    <DataGridTextColumn Header="재고 사용" Binding="{Binding StockUsed}" Width="80"/>
                                    <DataGridTextColumn Header="효율(%)" Binding="{Binding MaterialEfficiency, StringFormat=F2}" Width="80"/>
                                    <DataGridTextColumn Header="시간(ms)" Binding="{Binding ExecutionTimeMs, StringFormat=F3}" Width="100"/>
                                    <DataGridTextColumn Header="순위" Binding="{Binding Rank}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 비교 차트 -->
                            <GroupBox Header="비교 차트" Grid.Row="1" Margin="10,0,10,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="총 비용" HorizontalAlignment="Center" FontWeight="Bold" Margin="5"/>
                                        <lvc:CartesianChart x:Name="costChart" Height="220"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="재료 효율 (%)" HorizontalAlignment="Center" FontWeight="Bold" Margin="5"/>
                                        <lvc:CartesianChart x:Name="efficiencyChart" Height="220"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="실행 시간 (ms)" HorizontalAlignment="Center" FontWeight="Bold" Margin="5"/>
                                        <lvc:CartesianChart x:Name="timeChart" Height="220"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- 상세 비교 결과 -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         Padding="10"
                                         Margin="10,0,10,10"
                                         Text="{Binding ComparisonText, Mode=OneWay}"/>

                                <!-- 내보내기 버튼 -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,10,10">
                                    <Button Content="비교 결과 CSV로 저장"   Command="{Binding ExportComparisonToCsvCommand}"   Width="150" Margin="0,0,5,0" IsEnabled="{Binding HasComparisonResults}"/>
                                    <Button Content="비교 결과 Excel로 저장" Command="{Binding ExportComparisonToExcelCommand}" Width="150" IsEnabled="{Binding HasComparisonResults}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
    </TabItem>
    <TabItem Header="2D 절단 (Sheet)">
        <twod:TwoDTab/>
    </TabItem>
    </TabControl>
    </DockPanel>
</Window>
