<UserControl x:Class="CuttingStock.UI.TwoD.TwoDTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:svc="clr-namespace:CuttingStock.UI.Services"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1300">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <svc:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" MinWidth="280"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 입력 -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Margin="0,0,0,5">
                <GroupBox.Header>
                    <TextBlock><Run Text="시트 재고 (Sheets) "/><Run Text="{Binding Sheets.Count, StringFormat='({0}종)', Mode=OneWay}" Foreground="Gray"/></TextBlock>
                </GroupBox.Header>
                <StackPanel>
                    <DataGrid x:Name="sheetGrid" AutoGenerateColumns="False" Height="200" Margin="0,0,0,10"
                              ItemsSource="{Binding Sheets}"
                              CanUserAddRows="True" CanUserDeleteRows="True"
                              KeyDown="DataGrid_KeyDown" CellEditEnding="DataGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="가로 (mm)" Binding="{Binding Width}" Width="*"/>
                            <DataGridTextColumn Header="세로 (mm)" Binding="{Binding Height}" Width="*"/>
                            <DataGridTextColumn Header="수량 (개)" Binding="{Binding Quantity}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="시트 추가" Command="{Binding AddSheetCommand}" Margin="0,0,5,0" Width="80"/>
                        <Button Content="선택 삭제" Click="DeleteSheet_Click" Width="80"/>
                    </StackPanel>
                    <TextBlock Text="※ 엑셀 붙여넣기(Ctrl+V) 지원 / Delete키로 행 삭제" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Margin="0,5,0,0">
                <GroupBox.Header>
                    <TextBlock><Run Text="주문 (Items) "/><Run Text="{Binding Orders.Count, StringFormat='({0}종)', Mode=OneWay}" Foreground="Gray"/></TextBlock>
                </GroupBox.Header>
                <StackPanel>
                    <DataGrid x:Name="rectOrderGrid" AutoGenerateColumns="False" Height="200" Margin="0,0,0,10"
                              ItemsSource="{Binding Orders}"
                              CanUserAddRows="True" CanUserDeleteRows="True"
                              KeyDown="DataGrid_KeyDown" CellEditEnding="DataGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="가로 (mm)" Binding="{Binding Width}" Width="*"/>
                            <DataGridTextColumn Header="세로 (mm)" Binding="{Binding Height}" Width="*"/>
                            <DataGridTextColumn Header="수량 (개)" Binding="{Binding Quantity}" Width="*"/>
                            <DataGridCheckBoxColumn Header="회전" Binding="{Binding AllowRotation}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="주문 추가" Command="{Binding AddRectOrderCommand}" Width="80" Margin="0,0,5,0"/>
                        <Button Content="선택 삭제" Click="DeleteRectOrder_Click" Width="80"/>
                    </StackPanel>
                    <TextBlock Text="※ 엑셀 붙여넣기(Ctrl+V) 지원 / Delete키로 행 삭제" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                <Button Content="예제 로드" Command="{Binding LoadExampleCommand}" Width="80" Margin="0,0,5,0"/>
                <Button Content="시나리오 저장" Command="{Binding SaveScenarioCommand}" Width="100" Margin="0,0,5,0"
                        ToolTip="현재 시트/주문/옵션을 .json 파일로 저장"/>
                <Button Content="시나리오 열기" Command="{Binding LoadScenarioCommand}" Width="100" Margin="0,0,5,0"
                        ToolTip="저장된 .json 시나리오를 불러오기"/>
                <Button x:Name="btnRecent2D" Content="최근 ▾" Click="Recent2D_Click" Width="65" Margin="0,0,5,0"
                        ToolTip="최근에 사용한 2D 시나리오 (최대 5개)"/>
                <Button Content="전체 초기화" Command="{Binding ClearAllCommand}" Width="80"/>
            </WrapPanel>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="LightGray" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

        <!-- 오른쪽: 설정 + 결과 -->
        <Grid Grid.Column="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Header="2D 알고리즘 설정" Grid.Row="0" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="알고리즘 선택:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="5"
                              ItemsSource="{Binding SolverDescriptors}"
                              DisplayMemberPath="DisplayName"
                              SelectedIndex="{Binding AlgorithmIndex}"
                              ToolTip="선택한 알고리즘에 맞춰 아래 옵션의 적용 여부가 바뀝니다."/>

                    <TextBlock Text="파라미터:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="5,10,5,5"/>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="5,10,5,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Kerf:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"
                                   ToolTip="톱날 두께 (mm). 인접 절단마다 소비되는 재료 손실. 0 = 무시"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="5"
                                 Text="{Binding KerfText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="IntegerTextBox_PreviewTextInput"/>

                        <TextBlock Text="Trim:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="10,5,0,5"
                                   ToolTip="시트 가장자리에서 사용 불가한 트림 폭 (mm). 모든 변에 적용"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Margin="5"
                                 Text="{Binding TrimText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="IntegerTextBox_PreviewTextInput"/>

                        <TextBlock Text="Stage:" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Margin="10,5,0,5"
                                   IsEnabled="{Binding CanConfigureStage}"
                                   ToolTip="{Binding StageOptionTip}"/>
                        <ComboBox Grid.Row="0" Grid.Column="5" Margin="5"
                                  SelectedIndex="{Binding StageIndex}"
                                  IsEnabled="{Binding CanConfigureStage}"
                                  ToolTip="{Binding StageOptionTip}">
                            <ComboBoxItem Content="2-stage"/>
                            <ComboBoxItem Content="3-stage"/>
                        </ComboBox>

                        <TextBlock Text="α (mm² 단가):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"
                                   ToolTip="면적 1mm² 당 비용 (원/mm²)"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="5"
                                 Text="{Binding AlphaAreaText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="DecimalTextBox_PreviewTextInput"/>

                        <TextBlock Text="시간 제한(ms):" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="10,5,0,5"
                                   IsEnabled="{Binding CanConfigureTimeLimit}"
                                   ToolTip="{Binding TimeLimitOptionTip}"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="5"
                                 Text="{Binding TimeLimitText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanConfigureTimeLimit}"
                                 ToolTip="{Binding TimeLimitOptionTip}"
                                 PreviewTextInput="IntegerTextBox_PreviewTextInput"/>

                        <CheckBox Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2"
                                  Content="90° 회전 허용"
                                  IsChecked="{Binding AllowRotation}"
                                  Margin="10,5,0,5" VerticalAlignment="Center"
                                  ToolTip="True면 주문 사각형을 90° 돌려 배치 가능"/>
                    </Grid>

                    <TextBlock Text="재고 사용 순서:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="5"
                               ToolTip="여러 시트 크기 중 어떤 것부터 소진할지"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="5,0,5,5"
                              SelectedIndex="{Binding UsageOrderIndex}">
                        <ComboBoxItem Content="작은 것부터 (Small to Large)"/>
                        <ComboBoxItem Content="큰 것부터 (Large to Small)"/>
                    </ComboBox>

                    <TextBlock Text="적용 옵션:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="5,4,5,5"/>
                    <Border Grid.Row="3" Grid.Column="1" Margin="5,4,5,5" BorderBrush="LightGray" BorderThickness="1" Padding="5">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedSolverDescription}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedSolverCapabilityText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SelectedSolverAdvancedNotes}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="Gray" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                        <Button Content="최적화 실행" Command="{Binding CalculateCommand}" Width="120" Height="35" Margin="0,0,10,0" FontWeight="Bold"/>
                        <Button Content="알고리즘 비교" Command="{Binding CompareCommand}" Width="120" Height="35" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- 진행 상태 오버레이 -->
                    <Grid Grid.Row="0" Grid.RowSpan="5" Grid.ColumnSpan="2"
                          Background="#80FFFFFF"
                          Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar Width="200" Height="20"
                                         IsIndeterminate="{Binding ProgressIndeterminate}"
                                         Value="{Binding ProgressPercent}"
                                         Minimum="0" Maximum="100"/>
                            <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="Bold"/>
                            <Button Content="취소" Command="{Binding CancelCommand}" Width="80" Margin="0,8,0,0" HorizontalAlignment="Center"
                                    ToolTip="Esc 키로도 취소"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>

            <TabControl Grid.Row="1" x:Name="result2DTabs">
                <TabItem Header="결과 리포트">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" Padding="10"
                                 Text="{Binding ReportText, Mode=OneWay}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                            <Button Content="CSV로 내보내기"   Command="{Binding ExportToCsvCommand}"   Width="120" Margin="0,0,5,0" IsEnabled="{Binding HasSingleResult}"/>
                            <Button Content="Excel로 내보내기" Command="{Binding ExportToExcelCommand}" Width="120" IsEnabled="{Binding HasSingleResult}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="패턴 시각화">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasSingleResult, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="🧩" HorizontalAlignment="Center" FontSize="48" Foreground="LightGray"/>
                            <TextBlock Text="시트 위 배치 패턴이 여기에 그려집니다" HorizontalAlignment="Center"
                                       FontSize="14" Foreground="Gray" Margin="0,8,0,4"/>
                            <TextBlock Text="시트와 주문을 입력하고 '최적화 실행' 버튼을 누르세요"
                                       HorizontalAlignment="Center" FontSize="11" Foreground="DarkGray"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSingleResult, Converter={StaticResource BoolToVis}}">
                            <StackPanel x:Name="visualization2DPanel" Margin="10"/>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="알고리즘 비교">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasComparisonResults, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="📈" HorizontalAlignment="Center" FontSize="48" Foreground="LightGray"/>
                            <TextBlock Text="세 2D 알고리즘 결과를 비교합니다" HorizontalAlignment="Center"
                                       FontSize="14" Foreground="Gray" Margin="0,8,0,4"/>
                            <TextBlock Text="'알고리즘 비교' 버튼을 누르면 시트 사용/효율/시간 차트가 표시됩니다"
                                       HorizontalAlignment="Center" FontSize="11" Foreground="DarkGray"/>
                        </StackPanel>
                        <Grid Visibility="{Binding HasComparisonResults, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="260"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="0"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      Height="160" Margin="10"
                                      ItemsSource="{Binding CompareRows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="알고리즘" Binding="{Binding AlgorithmName}" Width="240"/>
                                    <DataGridTextColumn Header="시트 사용" Binding="{Binding SheetsUsed}" Width="100"/>
                                    <DataGridTextColumn Header="낭비(mm²)" Binding="{Binding WasteArea, StringFormat=N0}" Width="120"/>
                                    <DataGridTextColumn Header="효율(%)" Binding="{Binding MaterialEfficiency, StringFormat=F2}" Width="100"/>
                                    <DataGridTextColumn Header="시간(ms)" Binding="{Binding ExecutionTimeMs, StringFormat=F1}" Width="100"/>
                                    <DataGridTextColumn Header="순위" Binding="{Binding Rank}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <GroupBox Header="비교 차트" Grid.Row="1" Margin="10,0,10,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="시트 사용" HorizontalAlignment="Center" FontWeight="Bold" Margin="5"/>
                                        <lvc:CartesianChart x:Name="sheetsChart2D" Height="180"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="재료 효율 (%)" HorizontalAlignment="Center" FontWeight="Bold" Margin="5"/>
                                        <lvc:CartesianChart x:Name="effChart2D" Height="180"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="실행 시간 (ms)" HorizontalAlignment="Center" FontWeight="Bold" Margin="5"/>
                                        <lvc:CartesianChart x:Name="timeChart2D" Height="180"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <TextBox Grid.Row="2" IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" Padding="10" Margin="10,0,10,10"
                                     Text="{Binding CompareText, Mode=OneWay}"/>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,10,10">
                                <Button Content="비교 결과 CSV로 저장"   Command="{Binding ExportCompareToCsvCommand}"   Width="150" Margin="0,0,5,0" IsEnabled="{Binding HasComparisonResults}"/>
                                <Button Content="비교 결과 Excel로 저장" Command="{Binding ExportCompareToExcelCommand}" Width="150" IsEnabled="{Binding HasComparisonResults}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
