<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Authors>CuttingStock Team</Authors>
    <Description>Core library for cutting stock optimization algorithms. Contains Greedy Knapsack DP, Column Generation LP, and Arc Flow MIP (OR-Tools) solvers with kerf and welding support.</Description>
    <PackageProjectUrl>https://github.com/zacala1/CuttingStock</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zacala1/CuttingStock</RepositoryUrl>
    <PackageTags>optimization;cutting-stock;bin-packing;algorithm;rebar</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.OrTools" Version="9.15.6755" />
  </ItemGroup>

</Project>
